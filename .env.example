##################################
# Braiins Pool
##################################

# Development option: paste a read-only Braiins Pool API token here.
BRAIINS_POOL_TOKEN=

# Preferred production-style option: mount a token file and set this path.
# For Docker Compose, place the token in secrets/braiins_pool_token and set:
# BRAIINS_POOL_TOKEN_FILE=/run/secrets/braiins_pool_token
BRAIINS_POOL_TOKEN_FILE=

BRAIINS_POOL_COIN=btc

##################################
# Exporter
##################################

BRAIINS_POOL_API_BASE_URL=

##################################
# Polling
##################################

BRAIINS_POOL_POLL_INTERVAL=1m
BRAIINS_POOL_TIMEOUT=10s
BRAIINS_POOL_WORKER_METRICS_ENABLED=true
BRAIINS_POOL_MAX_WORKERS=100
BRAIINS_POOL_REWARDS_ENABLED=true
BRAIINS_POOL_PAYOUTS_ENABLED=true
BRAIINS_POOL_HISTORY_DAYS=7
